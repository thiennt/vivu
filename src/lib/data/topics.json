          "vocabulary": ["red", "blue", "green", "yellow", "orange", "purple", "pink", "brown", "black", "white"]
        },
        {
          "id": 8,
          "title": "Color Shades",
          "content": "Learn to describe different shades of colors",
          "vocabulary": ["light", "dark", "bright", "pale", "deep", "vivid"]
        }
      ]
    },
    {
