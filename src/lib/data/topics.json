{
  "topics": [
    {
      "id": 1,
      "title": "Basic Greetings",
      "description": "Learn how to greet people in English",
      "lessons": [
        {
          "id": 1,
          "title": "Hello and Goodbye",
          "content": "Learn basic greetings like Hello, Hi, Good morning, Goodbye, See you later",
          "vocabulary": ["Hello", "Hi", "Good morning", "Good afternoon", "Good evening", "Goodbye", "See you later", "Bye"]
        },
        {
          "id": 2,
          "title": "How are you?",
          "content": "Learn to ask and answer about well-being",
          "vocabulary": ["How are you?", "I'm fine", "I'm good", "Not bad", "How's it going?", "What's up?"]
        },
        {
          "id": 3,
          "title": "Nice to meet you",
          "content": "Introductions and meeting new people",
          "vocabulary": ["Nice to meet you", "Pleased to meet you", "My name is", "What's your name?"]
        }
      ]
    },
    {
      "id": 2,
      "title": "Numbers and Counting",
      "description": "Master numbers in English from 0 to 100",
      "lessons": [
        {
          "id": 4,
          "title": "Numbers 1-10",
          "content": "Learn to count from one to ten",
          "vocabulary": ["one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"]
        },
        {
          "id": 5,
          "title": "Numbers 11-20",
          "content": "Continue counting from eleven to twenty",
          "vocabulary": ["eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen", "twenty"]
        },
        {
          "id": 6,
          "title": "Tens and Hundreds",
          "content": "Learn tens (30, 40, 50...) and hundreds",
          "vocabulary": ["thirty", "forty", "fifty", "sixty", "seventy", "eighty", "ninety", "hundred"]
        }
      ]
    },
    {
