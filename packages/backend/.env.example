# YouTube Data API v3 Key
# Get your key from: https://console.cloud.google.com/ → APIs & Services → Credentials
# Enable "YouTube Data API v3" for the project first.
# Leave empty to use built-in mock data (great for development).
YOUTUBE_API_KEY=your_youtube_api_key_here

# Gemini API Key
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_api_key_here

# Puter.js API Token (optional, for Puter.js TTS provider)
# Get your token from: https://puter.com
PUTER_API_TOKEN=your_puter_token_here

# Server port
PORT=3000

# Allowed origins for CORS (comma-separated list)
# For development, include both localhost and 127.0.0.1
# For production, set this to your actual frontend URL(s)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
