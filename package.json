{
  "name": "vivu",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:backend": "turbo run dev --filter=@vivu/backend",
    "dev:client": "turbo run dev --filter=@vivu/client",
    "build": "turbo run build",
    "install:all": "npm install"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "devDependencies": {
    "turbo": "^2.8.0"
  }
}
